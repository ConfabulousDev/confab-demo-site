# Environment variables consumed by stack/docker-compose.yml.
#
# On the production demo VM, this file is rendered by cloud-init from
# tofu/terraform.tfvars at first boot (see tofu/cloud-init.yaml.tftpl).
# If you're running the stack locally with `docker compose up`, copy this
# to .env and fill in real values.
#
# Generation tips:
#   POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD: `openssl rand -hex 24`
#     (these end up in URL-style connection strings; base64 can contain
#      `/+=` which break URL parsing)
#   CSRF_SECRET_KEY, ADMIN_BOOTSTRAP_PASSWORD: `openssl rand -base64 32`

# Database
POSTGRES_PASSWORD=REPLACE-WITH-STRONG-PASSWORD

# Object storage
MINIO_ROOT_USER=confab-demo
MINIO_ROOT_PASSWORD=REPLACE-WITH-STRONG-PASSWORD

# App
CSRF_SECRET_KEY=REPLACE-WITH-32+CHAR-RANDOM-STRING

# Admin bootstrap. The account persists in the DB; remove
# ADMIN_BOOTSTRAP_PASSWORD from .env on the VM after first successful login.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE-WITH-STRONG-PASSWORD

# Super-admin access (comma-separated for multiple). Surfaces the admin panel.
SUPER_ADMIN_EMAILS=admin@example.com

# Support email surfaced in the app UI.
SUPPORT_EMAIL=support@example.com

# Smart Recap (dedicated Anthropic key with a hard monthly billing cap).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
